<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older; data_extraction_rules.xml covers newer versions -->
<full-backup-content>
    <!-- Kept out of backups and device transfer: the sync sign-in (a copied session would sign
         another device in), extension code (downloaded again from its repository), and
         downloaded updates (an APK alone is over Android's 25 MB backup limit) -->
    <exclude domain="file" path="data/sync.json" />
    <exclude domain="file" path="Extensions/" />
    <exclude domain="file" path="Extensions-jvm/" />
    <exclude domain="file" path="updates/" />
</full-backup-content>
